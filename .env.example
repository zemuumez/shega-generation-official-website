# Public: safe to expose to the browser, read-only, CDN-cached.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Base Application URL for payment callbacks & redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only. Scope this token to "Create" permission on studentApplication and donationRecord
SANITY_WRITE_TOKEN=

# Server-only. Used by the onboarding API and payment receipt email sender.
RESEND_API_KEY=

# Server-only. Rate limiting store for API endpoints.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only. Ethiopian Payment Gateway (Chapa) Integration for Telebirr, CBE Birr & ETB cards
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=

# Server-only. Global Payment Gateway (Stripe) Integration for USD & International cards
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
