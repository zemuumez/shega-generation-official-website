# Public: safe to expose to the browser, read-only, CDN-cached.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only. In the Sanity dashboard, scope this token to
# "Create" permission on the studentApplication document type ONLY.
# Never grant it read/write access to other document types.
SANITY_WRITE_TOKEN=

# Server-only. Used by the onboarding API to send diagnostic emails.
RESEND_API_KEY=

# Server-only. Rate limiting store for /api/onboarding/apply.
# Without these set, the endpoint fails closed in production
# (see lib/rateLimit.ts) rather than accepting unlimited traffic.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
